// ---------------------------------------------------------------------------
// Navigator Sea Land Limited — data model
//
// PostgreSQL, hosted on Supabase.
//
// Two connection strings are required, and they are not interchangeable:
//
//   DATABASE_URL  the transaction pooler (port 6543, `?pgbouncer=true`). The
//                 application uses this. Serverless functions open a connection
//                 per invocation and would exhaust Postgres' direct connection
//                 limit within minutes without it.
//   DIRECT_URL    a direct session connection (port 5432). Prisma Migrate uses
//                 this, because migrations need advisory locks and prepared
//                 statements that a transaction pooler does not support.
//
// Status values are stored as strings constrained in lib/constants.ts rather
// than as native Postgres enums, so rewording a label is a code change rather
// than a migration. See README for the reasoning.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Navigator Sea Land staff with access to the admin panel.
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  /// ADMIN | OPERATOR | VIEWER — see lib/constants.ts ROLES
  role         String    @default("OPERATOR")
  /// ALMATY | ATYRAU | MUMBAI
  office       String    @default("ALMATY")
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  ownedShipments     Shipment[]   @relation("ShipmentOwner")
  createdCheckpoints Checkpoint[] @relation("CheckpointAuthor")
  auditLogs          AuditLog[]

  @@index([email])
}

/// A counterparty: shipper, consignee or billing party.
model Client {
  id            String   @id @default(cuid())
  companyName   String
  contactPerson String?
  email         String?
  phone         String?
  addressLine   String?
  city          String?
  country       String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  shipmentsAsClient Shipment[] @relation("ShipmentClient")

  @@index([companyName])
}

/// One consignment under a project or contract.
model Shipment {
  id         String @id @default(cuid())
  /// Client-facing reference, format NSL-YYYY-NNNN. Unique and immutable.
  trackingId String @unique

  // --- Commercial references ------------------------------------------------
  /// Contract / project / job number used internally and by the client.
  contractRef String?
  projectName String?
  /// Underlying transport documents. Internal-only; never shown on /track.
  blNumber    String?
  cmrNumber   String?
  awbNumber   String?

  // --- Parties --------------------------------------------------------------
  clientId String?
  client   Client? @relation("ShipmentClient", fields: [clientId], references: [id], onDelete: SetNull)

  shipperName    String
  shipperContact String?
  shipperEmail   String?
  shipperPhone   String?
  shipperAddress String?

  consigneeName    String
  consigneeContact String?
  consigneeEmail   String?
  consigneePhone   String?
  consigneeAddress String?

  /// Billing party, when it differs from shipper/consignee.
  billingPartyName    String?
  billingPartyContact String?
  billingPartyEmail   String?
  billingPartyAddress String?

  // --- Route ----------------------------------------------------------------
  originCity         String
  originCountry      String
  destinationCity    String
  destinationCountry String
  portOfLoading      String?
  portOfDischarge    String?
  /// Comma-separated border crossings / transshipment points, e.g. "Khorgos,Aktau".
  borderCrossings    String?
  /// Comma-separated corridor keys — see lib/constants.ts CORRIDORS.
  corridors          String?
  /// Comma-separated mode keys: ROAD, RAIL, SEA, AIR, BARGE.
  modes              String  @default("ROAD")

  // --- Cargo ----------------------------------------------------------------
  cargoDescription String
  commodity        String?
  packageCount     Int?
  packageType      String?
  weightKg         Float?
  lengthCm         Float?
  widthCm          Float?
  heightCm         Float?
  volumeCbm        Float?
  /// True when cargo exceeds standard gauge and needs special handling.
  isOOG            Boolean @default(false)
  oogNotes         String?

  // --- Schedule & status ----------------------------------------------------
  /// Current status key — see lib/constants.ts SHIPMENT_STATUSES.
  status         String    @default("BOOKING_CONFIRMED")
  /// Set when the shipment is delayed or on hold; shown as a flag on the timeline.
  exceptionFlag  String?
  exceptionNote  String?
  etd            DateTime?
  eta            DateTime?
  actualDeparture DateTime?
  actualDelivery  DateTime?

  // --- Ownership & access ---------------------------------------------------
  ownerId String?
  owner   User?   @relation("ShipmentOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  /// When true, the Tracking ID alone opens the shipment on /track.
  /// When false (default), the visitor must also supply the consignee email
  /// or the contract reference.
  isPublicAccess Boolean @default(false)

  /// Recipients for milestone notifications (comma-separated).
  notifyEmails String?
  notifyPhones String?

  // --- ERP integration seam -------------------------------------------------
  /// Identifier in an external TMS/ERP (CargoWise, GoFreight, ...). Populated
  /// by a future sync job; unique so an import cannot duplicate a shipment.
  externalRef    String? @unique
  externalSource String?
  lastSyncedAt   DateTime?

  internalNotes String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  checkpoints   Checkpoint[]
  enquiries     ShipmentEnquiry[]
  notifications NotificationLog[]

  @@index([status])
  @@index([contractRef])
  @@index([consigneeName])
  @@index([createdAt])
}

/// A dated event on a shipment's timeline.
model Checkpoint {
  id         String   @id @default(cuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  /// Status key reached at this checkpoint — see SHIPMENT_STATUSES.
  status     String
  location   String
  country    String?
  /// The transport leg this event belongs to: ROAD, RAIL, SEA, AIR, BARGE.
  leg        String?
  occurredAt DateTime
  remarks    String?

  /// Operations can record an internal-only note (e.g. commercial detail)
  /// by unsetting this flag; the checkpoint then never appears on /track.
  isClientVisible Boolean @default(true)

  createdById String?
  createdBy   User?   @relation("CheckpointAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  attachments Attachment[]

  @@index([shipmentId, occurredAt])
}

/// A photo or document captured at a checkpoint (loading photos, POD, ...).
model Attachment {
  id           String     @id @default(cuid())
  checkpointId String
  checkpoint   Checkpoint @relation(fields: [checkpointId], references: [id], onDelete: Cascade)

  fileName    String
  storagePath String
  mimeType    String
  sizeBytes   Int
  caption     String?
  /// Documents are often commercially sensitive; default to internal-only.
  isClientVisible Boolean @default(false)
  createdAt   DateTime @default(now())

  @@index([checkpointId])
}

/// "Request a Quote" submission from the public site.
model QuoteRequest {
  id            String  @id @default(cuid())
  reference     String  @unique
  companyName   String
  contactPerson String
  email         String
  phone         String?
  country       String?

  originCity         String
  originCountry      String
  destinationCity    String
  destinationCountry String

  cargoDescription String
  commodity        String?
  packageCount     Int?
  weightKg         Float?
  lengthCm         Float?
  widthCm          Float?
  heightCm         Float?
  isOOG            Boolean @default(false)
  preferredModes   String?
  requiredByDate   DateTime?
  incoterms        String?
  additionalInfo   String?

  /// NEW | IN_REVIEW | QUOTED | WON | LOST | ARCHIVED
  status        String   @default("NEW")
  internalNotes String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status, createdAt])
}

/// "Contact us about this shipment" message raised from the tracking page.
model ShipmentEnquiry {
  id         String    @id @default(cuid())
  shipmentId String?
  shipment   Shipment? @relation(fields: [shipmentId], references: [id], onDelete: SetNull)

  /// Kept even when the shipment link is null, so the reference survives.
  trackingRef String?
  name        String
  email       String
  phone       String?
  message     String

  /// NEW | IN_PROGRESS | RESOLVED
  status    String   @default("NEW")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

/// Every notification the system attempted, whether or not it was delivered.
/// Doubles as the audit trail when channels are disabled (log-only mode).
model NotificationLog {
  id         String    @id @default(cuid())
  shipmentId String?
  shipment   Shipment? @relation(fields: [shipmentId], references: [id], onDelete: SetNull)

  /// EMAIL | WHATSAPP | SMS
  channel   String
  recipient String
  subject   String?
  body      String
  /// Milestone that triggered it, or MANUAL.
  trigger   String
  /// SENT | FAILED | SKIPPED_DISABLED | SKIPPED_NO_RECIPIENT
  status    String
  error     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Who changed what, for shipments and users.
model AuditLog {
  id       String  @id @default(cuid())
  userId   String?
  user     User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userEmail String?

  /// CREATE | UPDATE | DELETE | LOGIN | LOGIN_FAILED | EXPORT
  action     String
  entityType String
  entityId   String?
  summary    String
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
}

/// Sliding-window counter backing the tracking-form rate limit.
model RateLimit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}
