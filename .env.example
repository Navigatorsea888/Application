# ---------------------------------------------------------------------------
# Navigator Sea Land — environment configuration
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# Database — Supabase Postgres ------------------------------------------------
# Both are required and they are NOT interchangeable.
#
#   DATABASE_URL  transaction pooler, port 6543, with ?pgbouncer=true
#                 The application uses this. Serverless functions open a
#                 connection per invocation and would exhaust Postgres' direct
#                 connection limit within minutes without the pooler.
#   DIRECT_URL    direct session connection, port 5432
#                 Prisma Migrate uses this — migrations need advisory locks and
#                 prepared statements that a transaction pooler does not support.
#
# Both are in the Supabase dashboard under Connect → ORMs → Prisma. Replace
# [YOUR-PASSWORD] with the database password (Settings → Database → Reset
# database password), URL-encoded if it contains @ : / ? # [ ] or %.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# For local development against a Postgres on your own machine:
# DATABASE_URL="postgresql://user@localhost:5432/navigator?schema=public"
# DIRECT_URL="postgresql://user@localhost:5432/navigator?schema=public"

# Supabase --------------------------------------------------------------------
SUPABASE_URL="https://[PROJECT-REF].supabase.co"

# Safe to expose — it is the key browsers are meant to hold, and this
# application never uses it. It grants nothing, because row-level security is
# enabled on every table with no policies and the anon role holds no grants.
# See prisma/migrations/*_lock_down_public_api/.
SUPABASE_ANON_KEY=""

# SECRET. Bypasses row-level security entirely. Server-side only — never give
# this a NEXT_PUBLIC_ prefix and never send it to a browser.
# Supabase dashboard → Settings → API → service_role.
# Required only when STORAGE_DRIVER=supabase.
SUPABASE_SERVICE_ROLE_KEY=""

# File storage ----------------------------------------------------------------
# Checkpoint attachments: loading photographs, permits, PODs.
#   "local"     files on disk at UPLOAD_DIR. Development, or a VPS/container
#               with a persistent volume.
#   "supabase"  a PRIVATE Supabase Storage bucket. Required on a serverless
#               host, whose filesystem is ephemeral and per-instance.
STORAGE_DRIVER="local"
SUPABASE_STORAGE_BUCKET="shipment-attachments"
UPLOAD_DIR=""

# Auth ------------------------------------------------------------------------
# Generate with: openssl rand -base64 48
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
SESSION_MAX_AGE_HOURS="12"

# Site ------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_COMPANY_EMAIL="operations@navigatorsealand.com"

# Notifications ---------------------------------------------------------------
# false logs what would have been sent without sending it.
NOTIFY_EMAIL_ENABLED="false"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Navigator Sea Land <no-reply@navigatorsealand.com>"
NOTIFY_INTERNAL_INBOX="operations@navigatorsealand.com"

# WhatsApp — stubbed, see lib/notifications/channels/whatsapp.ts ---------------
NOTIFY_WHATSAPP_ENABLED="false"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""

# SMS — stubbed ---------------------------------------------------------------
NOTIFY_SMS_ENABLED="false"
SMS_API_KEY=""

# Seed admin — used by prisma/seed.ts on first run ----------------------------
SEED_ADMIN_EMAIL="admin@navigatorsealand.com"
SEED_ADMIN_PASSWORD="ChangeMe!2026"
